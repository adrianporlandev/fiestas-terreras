---
// Landing "Próximamente" – Fiestas de Las Terreras 2027
// Sin header ni footer, página standalone
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fiestas de Las Terreras 2027 – Próximamente</title>
    <meta name="description" content="Las Fiestas de Las Terreras 2027 están en camino. ¡Apunta la fecha y no te las pierdas!" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;900&display=swap" rel="stylesheet" />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="e0ae2db4-7bbb-480f-ae2e-fe23db8b011f"></script>

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html, body {
        height: 100%;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        overflow: hidden;
      }

      /* ── Animaciones ── */
      @keyframes fade-in-up {
        from { opacity: 0; transform: translateY(30px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes slide-in-up {
        from { opacity: 0; transform: translateY(50px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes fade-in-delay {
        0%   { opacity: 0; transform: translateY(20px); }
        50%  { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
      }
      @keyframes fade-in-delay-2 {
        0%   { opacity: 0; transform: translateY(20px); }
        60%  { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
      }
      @keyframes fade-in-delay-3 {
        0%   { opacity: 0; transform: translateY(20px); }
        70%  { opacity: 0; transform: translateY(20px); }
        100% { opacity: 1; transform: translateY(0); }
      }
      @keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%       { opacity: 0.4; transform: scale(1.5); }
      }
      @keyframes ping {
        0%   { transform: scale(1); opacity: 0.5; }
        100% { transform: scale(2); opacity: 0; }
      }
      @keyframes bounce-y {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-8px); }
      }

      .anim-fade-up      { animation: fade-in-up 1s ease-out both; }
      .anim-slide-up     { animation: slide-in-up 1.2s ease-out both; }
      .anim-delay-1      { animation: fade-in-delay 1.5s ease-out both; }
      .anim-delay-2      { animation: fade-in-delay-2 1.8s ease-out both; }
      .anim-delay-3      { animation: fade-in-delay-3 2.1s ease-out both; }
    </style>
  </head>

  <body>
    <section
      style="
        position: relative;
        width: 100%;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow: hidden;
        color: white;
      "
    >
      <!-- Imagen de fondo -->
      <img
        src="/fondo-terreras-1280.webp"
        srcset="/fondo-terreras-1280.webp 1280w, /fondo-terreras-1920.webp 1920w"
        sizes="100vw"
        alt=""
        aria-hidden="true"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;"
      />

      <!-- Overlay igual que el Hero del sitio -->
      <div
        aria-hidden="true"
        style="
          position: absolute;
          inset: 0;
          background: linear-gradient(to bottom right, rgba(0,0,0,0.70), rgba(0,0,0,0.50), rgba(136,19,55,0.30));
        "
      ></div>

      <!-- Partículas decorativas -->
      <div aria-hidden="true" style="position:absolute;inset:0;overflow:hidden;pointer-events:none;">
        <div style="position:absolute;top:5rem;left:2.5rem;width:8px;height:8px;background:rgba(255,255,255,0.30);border-radius:50%;animation:pulse-dot 2s ease-in-out infinite;"></div>
        <div style="position:absolute;top:10rem;right:5rem;width:5px;height:5px;background:rgba(255,255,255,0.40);border-radius:50%;animation:ping 1.5s cubic-bezier(0,0,0.2,1) infinite;"></div>
        <div style="position:absolute;bottom:10rem;left:5rem;width:10px;height:10px;background:rgba(255,255,255,0.20);border-radius:50%;animation:bounce-y 2s ease-in-out infinite;"></div>
        <div style="position:absolute;bottom:5rem;right:2.5rem;width:5px;height:5px;background:rgba(255,255,255,0.50);border-radius:50%;animation:pulse-dot 2s ease-in-out infinite 0.5s;"></div>
        <div style="position:absolute;top:33%;left:25%;width:6px;height:6px;background:rgba(251,113,133,0.40);border-radius:50%;animation:pulse-dot 2s ease-in-out infinite 0.3s;"></div>
        <div style="position:absolute;top:66%;right:33%;width:5px;height:5px;background:rgba(255,255,255,0.30);border-radius:50%;animation:ping 1.5s cubic-bezier(0,0,0.2,1) infinite 0.7s;"></div>
      </div>

      <!-- Contenido -->
      <div style="position:relative;z-index:10;padding:2rem 1.5rem;width:100%;max-width:56rem;margin:0 auto;">
        <div style="display:flex;flex-direction:column;align-items:center;gap:1.75rem;">

          <!-- Badge -->
          <div
            class="anim-fade-up"
            style="
              display:inline-flex;align-items:center;
              padding:0.5rem 1.25rem;
              border-radius:9999px;
              background:rgba(255,255,255,0.18);
              backdrop-filter:blur(8px);
              -webkit-backdrop-filter:blur(8px);
              border:1px solid rgba(255,255,255,0.30);
              font-size:0.85rem;font-weight:600;
              color:white;box-shadow:0 4px 16px rgba(0,0,0,0.2);
              letter-spacing:0.05em;
            "
          >
            <span style="margin-right:0.4rem;">📅</span>
            Las Terreras · Lorca · Murcia
          </div>

          <!-- Título -->
          <div class="anim-slide-up" style="line-height:1.05;">
            <p style="font-size:clamp(0.85rem,2vw,1.1rem);font-weight:500;color:rgba(255,255,255,0.75);letter-spacing:0.25em;text-transform:uppercase;margin-bottom:0.5rem;">
              Fiestas Patronales 2027
            </p>
            <h1
              style="
                font-size: clamp(2.8rem, 10vw, 7rem);
                font-weight: 900;
                letter-spacing: -0.02em;
                background: linear-gradient(to right, #ffffff, #ffe4e6);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
                filter: drop-shadow(0 4px 24px rgba(0,0,0,0.5));
                white-space: nowrap;
              "
            >
              Próximamente
            </h1>
          </div>

          <!-- Descripción -->
          <p
            class="anim-delay-1"
            style="
              max-width:30rem;
              font-size:clamp(1rem,2.5vw,1.25rem);
              color:rgba(255,255,255,0.85);
              line-height:1.7;
              font-weight:300;
              text-shadow: 0 2px 8px rgba(0,0,0,0.4);
            "
          >
            Las fiestas de 2026 han sido un éxito.<br />
            ¡Nos vemos en 2027 con más ganas que nunca!
          </p>

          <!-- Contador -->
          <div
            id="prox-countdown-wrapper"
            class="anim-delay-2"
            role="timer"
            aria-label="Cuenta atrás para las fiestas 2027"
          >
            <div id="prox-countdown-digits" style="display:flex;align-items:center;justify-content:center;gap:clamp(0.75rem,3vw,2rem);">

              <div style="text-align:center;">
                <div id="prox-cd-days" style="font-size:clamp(2.5rem,8vw,4rem);font-weight:700;color:white;line-height:1;text-shadow:0 2px 12px rgba(0,0,0,0.5);">--</div>
                <div style="font-size:clamp(0.7rem,1.5vw,0.9rem);color:rgba(255,255,255,0.75);margin-top:0.25rem;font-weight:500;letter-spacing:0.05em;">Días</div>
              </div>

              <div style="font-size:clamp(2rem,6vw,3.5rem);font-weight:700;color:rgba(255,255,255,0.50);padding-bottom:1.5rem;line-height:1;">:</div>

              <div style="text-align:center;">
                <div id="prox-cd-hours" style="font-size:clamp(2.5rem,8vw,4rem);font-weight:700;color:white;line-height:1;text-shadow:0 2px 12px rgba(0,0,0,0.5);">--</div>
                <div style="font-size:clamp(0.7rem,1.5vw,0.9rem);color:rgba(255,255,255,0.75);margin-top:0.25rem;font-weight:500;letter-spacing:0.05em;">Horas</div>
              </div>

              <div style="font-size:clamp(2rem,6vw,3.5rem);font-weight:700;color:rgba(255,255,255,0.50);padding-bottom:1.5rem;line-height:1;">:</div>

              <div style="text-align:center;">
                <div id="prox-cd-minutes" style="font-size:clamp(2.5rem,8vw,4rem);font-weight:700;color:white;line-height:1;text-shadow:0 2px 12px rgba(0,0,0,0.5);">--</div>
                <div style="font-size:clamp(0.7rem,1.5vw,0.9rem);color:rgba(255,255,255,0.75);margin-top:0.25rem;font-weight:500;letter-spacing:0.05em;">Minutos</div>
              </div>

              <div style="font-size:clamp(2rem,6vw,3.5rem);font-weight:700;color:rgba(255,255,255,0.50);padding-bottom:1.5rem;line-height:1;">:</div>

              <div style="text-align:center;">
                <div id="prox-cd-seconds" style="font-size:clamp(2.5rem,8vw,4rem);font-weight:700;color:white;line-height:1;text-shadow:0 2px 12px rgba(0,0,0,0.5);">--</div>
                <div style="font-size:clamp(0.7rem,1.5vw,0.9rem);color:rgba(255,255,255,0.75);margin-top:0.25rem;font-weight:500;letter-spacing:0.05em;">Segundos</div>
              </div>

            </div>

            <!-- Mensaje cuando llega el día -->
            <div
              id="prox-fiestas-started"
              style="display:none;flex-direction:column;align-items:center;gap:0.75rem;text-align:center;"
            >
              <span style="font-size:4rem;animation:bounce-y 1s ease-in-out infinite;">🎉</span>
              <p style="font-size:clamp(1.5rem,4vw,2.5rem);font-weight:800;color:white;text-shadow:0 2px 12px rgba(0,0,0,0.5);letter-spacing:0.02em;">
                ¡Ya estamos de Fiestas!
              </p>
            </div>
          </div>

          <!-- Fecha -->
          <p
            class="anim-delay-3"
            style="color:rgba(255,255,255,0.45);font-size:0.78rem;letter-spacing:0.25em;text-transform:uppercase;"
          >
            30 · julio · 2027 · 21:00 h
          </p>

        </div>
      </div>
    </section>

    <script>
      const TARGET = new Date('2027-07-30T21:00:00+02:00').getTime();

      const dayEl   = document.getElementById('prox-cd-days');
      const hourEl  = document.getElementById('prox-cd-hours');
      const minEl   = document.getElementById('prox-cd-minutes');
      const secEl   = document.getElementById('prox-cd-seconds');
      const digits  = document.getElementById('prox-countdown-digits');
      const started = document.getElementById('prox-fiestas-started');

      function pad(n) { return String(Math.max(0, n)).padStart(2, '0'); }

      function tick() {
        const diff = TARGET - Date.now();
        if (diff <= 0) {
          if (digits)  digits.style.display  = 'none';
          if (started) started.style.display = 'flex';
          return;
        }
        const t = Math.floor(diff / 1000);
        if (dayEl)  dayEl.textContent  = pad(Math.floor(t / 86400));
        if (hourEl) hourEl.textContent = pad(Math.floor((t % 86400) / 3600));
        if (minEl)  minEl.textContent  = pad(Math.floor((t % 3600) / 60));
        if (secEl)  secEl.textContent  = pad(t % 60);
      }

      tick();
      setInterval(tick, 1000);
    </script>
  </body>
</html>
