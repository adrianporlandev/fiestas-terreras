---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Fiestas de Las Terreras 2027 – Próximamente"
  description="Las Fiestas de Las Terreras 2027 están en camino. ¡Apunta la fecha y no te las pierdas!"
>
  <section
    class="w-full min-h-screen text-white flex items-center justify-center text-center relative overflow-hidden"
  >
    <!-- Fondo imagen -->
    <img
      src="/fondo-terreras-1280.webp"
      srcset="/fondo-terreras-1280.webp 1280w, /fondo-terreras-1920.webp 1920w"
      sizes="100vw"
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <!-- Overlay igual que el Hero del sitio -->
    <div
      class="absolute inset-0 bg-linear-to-br from-black/70 via-black/50 to-rose-900/30"
    ></div>

    <!-- Partículas decorativas (idénticas al Hero) -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute top-20 left-10 w-2 h-2 bg-white/30 rounded-full animate-pulse"></div>
      <div class="absolute top-40 right-20 w-1 h-1 bg-white/40 rounded-full animate-ping"></div>
      <div class="absolute bottom-40 left-20 w-3 h-3 bg-white/20 rounded-full animate-bounce"></div>
      <div class="absolute bottom-20 right-10 w-1 h-1 bg-white/50 rounded-full animate-pulse"></div>
      <div class="absolute top-1/3 left-1/4 w-1.5 h-1.5 bg-rose-300/40 rounded-full animate-pulse"></div>
      <div class="absolute top-2/3 right-1/3 w-1 h-1 bg-white/30 rounded-full animate-ping" style="animation-delay:0.7s"></div>
    </div>

    <!-- Contenido centrado -->
    <div class="container px-4 md:px-6 relative z-10">
      <div class="space-y-8 animate-fade-in-up max-w-3xl mx-auto">

        <!-- Badge -->
        <div
          class="inline-flex items-center px-4 py-2 rounded-full bg-white/20 backdrop-blur-sm border border-white/30 text-sm font-medium text-white shadow-lg"
        >
          <span class="mr-2">📅</span>
          Las Terreras · Lorca · Murcia
        </div>

        <!-- Título -->
        <div class="space-y-3 animate-slide-in-up">
          <p class="text-lg md:text-xl font-medium text-white/80 tracking-widest uppercase">
            Fiestas Patronales
          </p>
          <h1
            class="text-6xl font-bold tracking-tighter sm:text-7xl md:text-8xl lg:text-9xl/none drop-shadow-2xl bg-linear-to-r from-white to-rose-100 bg-clip-text text-transparent"
          >
            Próximamente
          </h1>
        </div>

        <!-- Descripción -->
        <p class="mx-auto max-w-xl text-xl md:text-2xl drop-shadow-lg text-white/85 leading-relaxed animate-fade-in-delay">
          Las fiestas de 2026 han sido un éxito.<br />
          ¡Nos vemos en 2027 con más ganas que nunca!
        </p>

        <!-- Contador -->
        <div id="prox-countdown-wrapper" class="animate-fade-in-delay-2" role="timer" aria-label="Cuenta atrás para las fiestas 2027">
          <div id="prox-countdown-digits" class="flex justify-center items-center space-x-4 md:space-x-8">
            <div class="text-center">
              <div id="prox-cd-days" class="text-5xl md:text-6xl font-bold text-white drop-shadow-lg">--</div>
              <div class="text-sm md:text-base text-white/75 font-medium mt-1">Días</div>
            </div>
            <div class="text-4xl md:text-5xl font-bold text-white/60 pb-6">:</div>
            <div class="text-center">
              <div id="prox-cd-hours" class="text-5xl md:text-6xl font-bold text-white drop-shadow-lg">--</div>
              <div class="text-sm md:text-base text-white/75 font-medium mt-1">Horas</div>
            </div>
            <div class="text-4xl md:text-5xl font-bold text-white/60 pb-6">:</div>
            <div class="text-center">
              <div id="prox-cd-minutes" class="text-5xl md:text-6xl font-bold text-white drop-shadow-lg">--</div>
              <div class="text-sm md:text-base text-white/75 font-medium mt-1">Minutos</div>
            </div>
            <div class="text-4xl md:text-5xl font-bold text-white/60 pb-6">:</div>
            <div class="text-center">
              <div id="prox-cd-seconds" class="text-5xl md:text-6xl font-bold text-white drop-shadow-lg">--</div>
              <div class="text-sm md:text-base text-white/75 font-medium mt-1">Segundos</div>
            </div>
          </div>

          <!-- Mensaje de inicio de fiestas -->
          <div
            id="prox-fiestas-started"
            style="display:none"
            class="flex flex-col items-center gap-3 text-center"
          >
            <span class="text-6xl animate-bounce">🎉</span>
            <p class="text-3xl md:text-4xl font-extrabold text-white drop-shadow-lg tracking-wide">
              ¡Ya estamos de Fiestas!
            </p>
          </div>
        </div>

        <!-- Fecha destino -->
        <p class="text-white/50 text-sm tracking-widest uppercase animate-fade-in-delay-3">
          30 · agosto · 2027 · 21:00 h
        </p>

        <!-- Botón volver a edición anterior -->
        <div class="animate-fade-in-delay-3">
          <a
            href="https://github.com/adrianporlandev/fiestas-terreras/tree/fiestas-2026"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-12 items-center justify-center rounded-full border border-white/30 bg-white/10 backdrop-blur-sm px-6 text-sm font-medium text-white/70 shadow-lg transition-all duration-300 hover:bg-white/20 hover:text-white hover:scale-105"
          >
            <span class="mr-2">📂</span>
            Edición 2026
          </a>
        </div>

      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  const TARGET = new Date('2027-08-30T21:00:00+02:00').getTime();

  const dayEl    = document.getElementById('prox-cd-days');
  const hourEl   = document.getElementById('prox-cd-hours');
  const minEl    = document.getElementById('prox-cd-minutes');
  const secEl    = document.getElementById('prox-cd-seconds');
  const digits   = document.getElementById('prox-countdown-digits');
  const started  = document.getElementById('prox-fiestas-started');

  function pad(n) { return String(Math.max(0, n)).padStart(2, '0'); }

  function tick() {
    const diff = TARGET - Date.now();
    if (diff <= 0) {
      if (digits)  digits.style.display  = 'none';
      if (started) started.style.display = 'flex';
      return;
    }
    const totalSec = Math.floor(diff / 1000);
    const days    = Math.floor(totalSec / 86400);
    const hours   = Math.floor((totalSec % 86400) / 3600);
    const minutes = Math.floor((totalSec % 3600) / 60);
    const seconds = totalSec % 60;

    if (dayEl)  dayEl.textContent  = pad(days);
    if (hourEl) hourEl.textContent = pad(hours);
    if (minEl)  minEl.textContent  = pad(minutes);
    if (secEl)  secEl.textContent  = pad(seconds);
  }

  tick();
  setInterval(tick, 1000);
</script>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes slide-in-up {
    from { opacity: 0; transform: translateY(50px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in-delay {
    0%   { opacity: 0; transform: translateY(20px); }
    50%  { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in-delay-2 {
    0%   { opacity: 0; transform: translateY(20px); }
    60%  { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }
  @keyframes fade-in-delay-3 {
    0%   { opacity: 0; transform: translateY(20px); }
    70%  { opacity: 0; transform: translateY(20px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in-up      { animation: fade-in-up 1s ease-out; }
  .animate-slide-in-up     { animation: slide-in-up 1.2s ease-out; }
  .animate-fade-in-delay   { animation: fade-in-delay 1.5s ease-out; }
  .animate-fade-in-delay-2 { animation: fade-in-delay-2 1.8s ease-out; }
  .animate-fade-in-delay-3 { animation: fade-in-delay-3 2.1s ease-out; }
</style>
